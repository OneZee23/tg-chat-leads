# Секреты. TG_SESSION в .env — это полноценный доступ к аккаунту:
# кто угодно с этой строкой читает переписку и пишет от твоего имени.
# Никогда не коммитить.
.env
.env.*
!.env.example

node_modules/
dist/
coverage/

# Выгрузки лидов — персональные данные третьих лиц, в git им не место.
export/
*.csv

*.log
.DS_Store
.idea/
.vscode/

# Содержимое рассылки — твой личный текст и скриншоты. У каждого своё.
# В репозитории лежит только пример: posts/cold-outreach/text.example.md
posts/cold-outreach/text.md
posts/cold-outreach/images/
