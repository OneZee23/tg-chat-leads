# Секреты. TG_SESSION в .env — это полноценный доступ к аккаунту:
# кто угодно с этой строкой читает переписку и пишет от твоего имени.
# Никогда не коммитить.
.env
.env.*
!.env.example

node_modules/
dist/
coverage/

# Выгрузки лидов — персональные данные третьих лиц, в git им не место.
export/
*.csv

*.log
.DS_Store
.idea/
.vscode/
