# Секреты. TG_SESSION в .env — это полноценный доступ к аккаунту:
# кто угодно с этой строкой читает переписку и пишет от твоего имени.
# Никогда не коммитить.
.env
.env.*
!.env.example

node_modules/
dist/
coverage/

# Выгрузки лидов — персональные данные третьих лиц, в git им не место.
export/
*.csv

# Обмен с ассистентом: входящие ответы живых людей и наши реплики им.
# Персональные данные третьих лиц — в git им не место, как и выгрузкам.
inbox/
outbox/

*.log
.DS_Store
.idea/
.vscode/

# Содержимое рассылки — твой личный текст и скриншоты. У каждого своё.
# В репозитории лежат только примеры: text.example.md / body.example.md
posts/cold-outreach/text.md
posts/cold-outreach/body.md
posts/cold-outreach/images/

# Служебная директория исполнения планов (леджер, брифы, диффы на ревью).
.superpowers/
reviews/
