{
  "name": "teach-track-leadgen",
  "version": "0.1.0",
  "description": "Сбор лидов из телеграм-чатов через userbot-аккаунт: читает открытые чаты, вылавливает тех, кто рекламирует свои услуги, складывает уникальным списком",
  "license": "MIT",
  "author": "Nikita Shevelev (OneZee)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/**/*.ts\"",
    "start": "nest start",
    "start:dev": "NODE_ENV=development nest start --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,scripts}/**/*.ts\" --fix",
    "lint:ci": "eslint \"{src,scripts}/**/*.ts\"",
    "test": "jest",
    "refresh": "curl -sS -XPOST 'http://127.0.0.1:3010/outreach/refresh?limit=30'",
    "leads": "curl -sS 'http://127.0.0.1:3010/outreach/next?limit=30'",
    "replies": "curl -sS 'http://127.0.0.1:3010/outreach/replies'",
    "recount": "curl -sS --max-time 900 -XPOST 'http://127.0.0.1:3010/outreach/recount-replies'",
    "autoreply": "curl -sS --max-time 900 -XPOST 'http://127.0.0.1:3010/outreach/auto-reply'",
    "autoreply:send": "curl -sS --max-time 900 -XPOST 'http://127.0.0.1:3010/outreach/auto-reply?send=true'",
    "inbox": "curl -sS --max-time 900 -XPOST 'http://127.0.0.1:3010/outreach/inbox?limit=200'",
    "reviews": "curl -sS --max-time 1800 -XPOST 'http://127.0.0.1:3010/outreach/reviews?limit=200'",
    "reviews:build": "sh scripts/reviews-build.sh",
    "outbox": "sh scripts/outbox.sh",
    "outbox:send": "sh scripts/outbox.sh --send",
    "status": "curl -sS 'http://127.0.0.1:3010/send/status'",
    "commands": "curl -sS 'http://127.0.0.1:3010/send/help'",
    "help": "curl -sS 'http://127.0.0.1:3010/send/help'",
    "send": "sh scripts/send.sh",
    "send:go": "sh scripts/send.sh --go",
    "send:release": "curl -sS -XPOST 'http://127.0.0.1:3010/send/release-stuck'",
    "wrote": "sh scripts/mark.sh contacted",
    "skip": "sh scripts/mark.sh skip",
    "chats": "curl -sS 'http://127.0.0.1:3010/chats?withCounts=true'",
    "session:create": "ts-node -r dotenv/config scripts/create-tg-session.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "typeorm": "sh typeorm.sh"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/typeorm": "^10.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.7",
    "nestjs-pino": "^4.1.0",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "telegram": "^2.26.22",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.10",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "^29.7.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@common/(.*)$": "<rootDir>/common/$1",
      "^@infra/(.*)$": "<rootDir>/infra/$1",
      "^@modules/(.*)$": "<rootDir>/modules/$1"
    }
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
