# ─────────────────────────────────────────────────────────────────────────
#  Telegram (userbot, MTProto)
# ─────────────────────────────────────────────────────────────────────────
# api_id / api_hash берутся на https://my.telegram.org → API development tools.
# Заводятся один раз на аккаунт, к боту отношения не имеют.
TG_API_ID=
TG_API_HASH=

# Телефон аккаунта в международном формате, с плюсом: +79991234567.
# Нужен только скрипту создания сессии, в рантайме не используется.
TG_PHONE=

# Строка сессии. Получается один раз: `yarn session:create` → скрипт
# спросит код из Telegram (и пароль 2FA, если включён) и напечатает строку.
# ЭТО СЕКРЕТ УРОВНЯ ПАРОЛЯ. Утечёт — отзывай сессию в Telegram:
# Настройки → Устройства → завершить сеанс.
TG_SESSION=

# Порог автосна при FloodWait (сек). Если Telegram просит подождать меньше
# этого — GramJS уснёт сам и повторит запрос. Больше — кинет ошибку, и мы
# аккуратно остановим скан этого чата.
TG_FLOOD_SLEEP_THRESHOLD=120

# ─────────────────────────────────────────────────────────────────────────
#  Что сканируем
# ─────────────────────────────────────────────────────────────────────────
# Через запятую: @username чата, ссылка t.me/... или числовой id.
# Аккаунт ДОЛЖЕН уже состоять в этих чатах — вступай руками, скрипт не вступает.
SCAN_CHATS=

# Сколько последних сообщений забрать при ПЕРВОМ проходе по чату.
# Дальше идём только по новым (курсор хранится в tg_scan_state).
SCAN_INITIAL_LIMIT=2000

# Потолок сообщений за один запуск на чат — страховка от «случайно выкачал
# полгода истории».
SCAN_MAX_MESSAGES_PER_RUN=5000

# Пауза между запросами истории внутри чата (сек). Это и есть «потихонечку».
# Ниже 1 не опускай: 200 сообщений за запрос, при 2 сек это ~100 msg/сек —
# уже достаточно быстро и совершенно незаметно для Telegram.
SCAN_WAIT_TIME_SEC=2

# Пауза между чатами (сек) + случайный разброс сверху до этого же значения.
SCAN_DELAY_BETWEEN_CHATS_SEC=15

# Запустить полный проход сразу при старте приложения.
SCAN_ON_START=false

# Периодический проход, в минутах. 0 — выключено, дёргаешь руками
# через POST /scan/run. Разумное значение, если хочется автоматики: 360 (6ч).
SCAN_INTERVAL_MINUTES=0

# Слушать новые сообщения в реальном времени и складывать лидов на лету.
LISTEN_ENABLED=true

# Сколько символов текста сообщения сохранять как образец (0 — не сохранять).
SAMPLE_TEXT_LIMIT=1000

# ─────────────────────────────────────────────────────────────────────────
#  Эвристика «это реклама своих услуг»
# ─────────────────────────────────────────────────────────────────────────
# Порог score, начиная с которого сообщение считается рекламой препода.
AD_MIN_SCORE=3

# Дополнительные ключевые слова через запятую (в нижнем регистре).
# Складываются с дефолтным списком из ad-detector.ts.
AD_EXTRA_KEYWORDS=

# Стоп-слова: если сработали — сообщение НЕ реклама, score обнуляется.
# Отсекает тех, кто ИЩЕТ преподавателя, а не предлагает себя.
AD_EXTRA_STOP_WORDS=

# Сохранять в базу вообще всех авторов или только тех, кто прошёл порог.
# false — база чище, true — можно потом перепросчитать эвристику по образцам.
SAVE_NON_AD_AUTHORS=false

# ─────────────────────────────────────────────────────────────────────────
#  Диалоги: поиск чатов и отсев тех, кому уже писал
# ─────────────────────────────────────────────────────────────────────────
# Сколько диалогов пройти в GET /chats и POST /leads/sync-contacted.
DIALOGS_LIMIT=1000

# Глубокая проверка «писал ли я этому человеку».
# Дешёвый признак — моё сообщение последнее в диалоге; для холодного аутрича
# без ответа срабатывает почти всегда и стоит ноль запросов. Но если человек
# ОТВЕТИЛ, последнее сообщение уже его — тогда лезем в историю диалога.
# Выключать не советую: промах здесь = повторное письмо человеку.
CONTACTED_DEEP_CHECK=true
CONTACTED_DEEP_LIMIT=50
CONTACTED_DEEP_DELAY_MS=400

# ─────────────────────────────────────────────────────────────────────────
#  Автоматическая рассылка
# ─────────────────────────────────────────────────────────────────────────
# Папка с текстом и картинками: <dir>/text.md и <dir>/images/*.png|jpg
OUTREACH_CONTENT_DIR=

# ТОЛЬКО ПОКАЗАТЬ, ничего не отправлять и статусы не трогать.
# По умолчанию true. Первый запуск делай только так.
SEND_DRY_RUN=true

# Стоп-кран: сколько сообщений максимум за один запуск.
SEND_MAX_PER_RUN=15

# Пауза между сообщениями, секунды. Реальная — от значения до его удвоения.
# 90 сек = меньше 40 сообщений в час. Ровный быстрый темп — главный признак
# рассылки для антиспама Telegram.
SEND_DELAY_SEC=90

# Сколько ошибок подряд терпим, прежде чем остановиться. Череда ошибок
# обычно значит, что аккаунт уже прижали.
SEND_MAX_CONSECUTIVE_ERRORS=3

# Скользящий суточный бюджет. В отличие от SEND_MAX_PER_RUN его нельзя
# обойти повторным запуском: считается по журналу отправок за последние
# 24 часа. 08.08.2026 такого предохранителя не было, и пять запусков
# по 50 ничто бы не остановило.
SEND_MAX_PER_DAY=20

# Окно активности для режима расписания, часы местного времени.
SEND_WINDOW_START_HOUR=10
SEND_WINDOW_END_HOUR=21

# Минимальный зазор между сообщениями в режиме расписания, секунды.
SEND_SCHEDULE_MIN_GAP_SEC=300

# Запускать планировщик сразу при старте приложения.
SEND_SCHEDULE_AUTOSTART=false

# ─────────────────────────────────────────────────────────────────────────
#  Проверка статуса аккаунта у @SpamBot
# ─────────────────────────────────────────────────────────────────────────
# Сколько минут доверять прошлому ответу бота.
ACCOUNT_CHECK_TTL_MIN=30

# Не пускать рассылку, если ответ @SpamBot не удалось разобрать.
# «Не понял» — не то же самое, что «всё хорошо», поэтому по умолчанию true.
ACCOUNT_BLOCK_ON_UNKNOWN=true
ACCOUNT_REPLY_ATTEMPTS=10
ACCOUNT_REPLY_POLL_MS=1000

# ─────────────────────────────────────────────────────────────────────────
#  База
# ─────────────────────────────────────────────────────────────────────────
DB_HOST=localhost
# 5434: 5432 занят tt-db (TeachTrack), 5433 — triptrack-db.
DB_PORT=5434
DB_NAME=teach_track_leadgen
DB_USER=postgres
DB_PASS=postgres
DB_LOG=false
DB_SYNC=false
DB_MIGRATE=true

# ─────────────────────────────────────────────────────────────────────────
#  HTTP
# ─────────────────────────────────────────────────────────────────────────
PORT=3010
# Слушаем только loopback: снаружи к этой штуке ходить незачем.
HOST=127.0.0.1
# Если задан — каждый запрос должен нести заголовок `x-api-token`.
# Пусто = без проверки (нормально, пока слушаем 127.0.0.1).
API_TOKEN=

LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────────────────────
# RESEARCH — поиск по чатам для ресёрча (ТОЛЬКО ЧТЕНИЕ, ничего не отправляет)
# ─────────────────────────────────────────────────────────────────────────────

# Чаты через запятую. Аккаунт должен в них состоять.
RESEARCH_CHATS=@Chancenkarte_waiting

# Запросы через ТОЧКУ С ЗАПЯТОЙ: сама фраза часто содержит запятую.
RESEARCH_QUERIES=Тбилиси;Грузия;6 месяцев;ВНЖ;страховка;Sperrkonto;блокированный счёт;финансирование;подача;термин

# Потолок находок на один запрос (поиск отдаёт от новых к старым)
RESEARCH_PER_QUERY_LIMIT=40

# Отсечка по возрасту сообщения в днях. 0 — без отсечки.
# Для визовых чатов важно: правила меняются, старый совет читается как свежий.
RESEARCH_SINCE_DAYS=400

# Минимальная длина текста: отсекает «+1», «да», «спасибо»
RESEARCH_MIN_TEXT_LEN=40

# Подтягивать сообщение, на которое отвечали (+1 запрос на находку)
RESEARCH_WITH_CONTEXT=true

# Пауза между запросами, сек
RESEARCH_DELAY_SEC=4

# Папка для дайджестов, внутри репозитория. Должна быть в .gitignore.
RESEARCH_DIR=research
